# Environment Configuration Template
PROJECT_NAME="MoveInSync Commute Policy Assistant"
VERSION="1.0.0"
API_V1_PREFIX="/api/v1"
DEBUG=false

# Security & Authentication
JWT_SECRET_KEY="super-secret-key-moveinsync-dev-interview-2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Chroma Vector Storage & Auto-seeding
CHROMA_PERSIST_DIR="./chroma_db"
CHROMA_COLLECTION_NAME="commute_policies"
POLICY_STORE_FILE="./policy_versions.json"
POLICIES_DIR="./data/policies"
AUTO_SEED_ON_STARTUP=true

# Retrieval & Hybrid Search
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
TOP_K_CHUNKS=3
ENABLE_HYBRID_SEARCH=false
SIMILARITY_DISTANCE_THRESHOLD=0.85

# LLM Provider ("mock", "gemini", "groq")
LLM_PROVIDER="mock"
LLM_API_KEY=""
LLM_MODEL_NAME="gemini-1.5-flash"
